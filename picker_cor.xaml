<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar Cor" Width="400" Height="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="picker_preview_key_down">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Palette header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Paleta guardada" FontWeight="SemiBold"
                       VerticalAlignment="Center" FontFamily="Segoe UI"/>
            <Button DockPanel.Dock="Right" Content="Gerir paleta" Height="22" Width="90"
                    FontSize="11" Click="gerir_paleta"
                    ToolTip="Abre o separador Cores"/>
        </DockPanel>

        <!-- Swatches -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1"
                CornerRadius="4" Padding="4" MinHeight="36">
            <WrapPanel x:Name="pnlSwatches"/>
        </Border>

        <!-- HEX + preview -->
        <DockPanel Grid.Row="2" Margin="0,12,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Hex:" Width="34"
                       VerticalAlignment="Center" FontFamily="Segoe UI"/>
            <Border x:Name="colorPreview" DockPanel.Dock="Right"
                    Width="48" Height="28" BorderBrush="#888" BorderThickness="1"
                    CornerRadius="3" Margin="8,0,0,0"/>
            <TextBlock DockPanel.Dock="Left" Text="#" VerticalAlignment="Center"
                       Margin="0,0,2,0" FontFamily="Consolas" FontSize="13"/>
            <TextBox x:Name="txtHex" Height="28" MaxLength="6"
                     FontFamily="Consolas" FontSize="13"
                     VerticalContentAlignment="Center"
                     TextChanged="hex_changed"
                     GotFocus="hex_got_focus"/>
        </DockPanel>

        <!-- RGB inputs -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="R" VerticalAlignment="Center"
                       Foreground="#CC0000" FontWeight="SemiBold"/>
            <TextBox Grid.Column="1" x:Name="txtR" Height="26" MaxLength="3"
                     VerticalContentAlignment="Center"
                     TextChanged="rgb_text_changed"/>
            <TextBlock Grid.Column="3" Text="G" VerticalAlignment="Center"
                       Foreground="#007700" FontWeight="SemiBold"/>
            <TextBox Grid.Column="4" x:Name="txtG" Height="26" MaxLength="3"
                     VerticalContentAlignment="Center"
                     TextChanged="rgb_text_changed"/>
            <TextBlock Grid.Column="6" Text="B" VerticalAlignment="Center"
                       Foreground="#0000CC" FontWeight="SemiBold"/>
            <TextBox Grid.Column="7" x:Name="txtB" Height="26" MaxLength="3"
                     VerticalContentAlignment="Center"
                     TextChanged="rgb_text_changed"/>
        </Grid>

        <!-- Spacer -->
        <Grid Grid.Row="4"/>

        <!-- Buttons -->
        <DockPanel Grid.Row="5" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Misturador..." Width="96" Height="28"
                    Click="abrir_misturador"
                    ToolTip="Abre o seletor do Windows com o quadrado de mistura de cores"/>
            <Button DockPanel.Dock="Right" Content="OK" Width="72" Height="28"
                    FontWeight="Bold" Click="ok_click"/>
            <Button DockPanel.Dock="Right" Content="Cancelar" Width="72" Height="28"
                    Margin="0,0,8,0" Click="cancelar"/>
            <Button DockPanel.Dock="Right" Content="None" Width="84" Height="28"
                    Margin="0,0,8,0" Click="sem_cor"/>
        </DockPanel>
    </Grid>
</Window>
